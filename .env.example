# Firebase 서비스 계정(Firestore, 로그인에 사용)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_WEB_API_KEY=
# 이 앱을 쓸 수 있는 이메일(쉼표로 구분). Firebase 콘솔에서 이 이메일로 계정을 만들어 두세요.
ALLOWED_EMAILS=
# 스캔(그림) PDF를 읽을 때만 필요 (선택). Google AI Studio에서 무료로 발급
GEMINI_API_KEY=
# 비워 두면 기본 모델을 씁니다 (선택)
GEMINI_MODEL=
# 회원가입 (SIGNUP_CODE를 정해야 회원가입이 열립니다)
SIGNUP_CODE=
# 가입 이메일을 한 도메인으로 제한하려면 (선택, 예: hufs.ac.kr)
SIGNUP_EMAIL_DOMAIN=
# 가입 직후 자동 로그인에 쓰는 웹 API 키 (선택, firebase-client.ts의 apiKey 값)
FIREBASE_WEB_API_KEY=