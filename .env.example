# Firebase 서비스 계정(Firestore, 로그인에 사용)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_WEB_API_KEY=
# 이 앱을 쓸 수 있는 이메일(쉼표로 구분). Firebase 콘솔에서 이 이메일로 계정을 만들어 두세요.
ALLOWED_EMAILS=
# 요약에 쓰는 Anthropic API 키
ANTHROPIC_API_KEY=
# (선택) 회원가입 코드. 값을 넣으면 /signup 에서 이 코드를 아는 사람이 직접 가입할 수 있습니다.
# 가입이 끝나면 이 변수를 지우세요(가입 화면이 사라집니다). 길고 무작위인 문자열을 쓰세요.
SIGNUP_CODE=
# (선택) 요약 모델. 기본값은 claude-sonnet-5-5
ANTHROPIC_MODEL=
